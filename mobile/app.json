{
  "expo": {
    "name": "LoveMe",
    "slug": "love-me",
    "owner": "jeongsulims-team",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "loveme",
    "userInterfaceStyle": "light",
    "primaryColor": "#f8f3ed",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.beforeithappens.loveme",
      "splash": {
        "backgroundColor": "#f8f3ed",
        "resizeMode": "contain"
      }
    },
    "android": {
      "package": "com.beforeithappens.loveme",
      "adaptiveIcon": {
        "backgroundColor": "#f8f3ed",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "splash": {
        "backgroundColor": "#f8f3ed",
        "resizeMode": "contain"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "backgroundColor": "#f8f3ed",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f8f3ed",
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "0ec4ea96-f071-4d0a-885f-57a3aa218a51"
      }
    }
  }
}
